{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "src/**/*", "electron/**/*", "electron/types.d.ts"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "typeRoots": ["./node_modules/@types", "./src", "./electron", "./electron/types.d.ts"]
    }
  }
}
